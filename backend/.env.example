# ---------------------------------------------------------------------------
# LLM backend — set ONE of the two options below
# ---------------------------------------------------------------------------

# Option A: Groq cloud (openai/gpt-oss-120b is the default model)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Option B: Local vLLM server (used automatically when GROQ_API_KEY is unset).
# Must NOT be port 8000 — that is this API.
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=
# Firebase project whose ID tokens are accepted (must match the frontend config)
FIREBASE_PROJECT_ID=trustflow-45bec
# Allow the "Continue as guest" button (all guests share one account — demo only)
# ALLOW_GUEST_LOGIN=false
# Comma-separated browser origins allowed to call the API
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Storage (relative paths resolve against the backend/ directory)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./hackstrom.db
CHECKPOINT_DB=checkpoints.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
# Defaults to <repo>/country_rules
# COUNTRY_RULES_DIR=/app/country_rules

# ---------------------------------------------------------------------------
# docker-compose only
# ---------------------------------------------------------------------------
# GRAFANA_ADMIN_PASSWORD=change-me
