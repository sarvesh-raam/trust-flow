# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Public address. With no domain, use your server's IP with dashes + .sslip.io,
# e.g. 129-154-10-20.sslip.io  (also add it in Firebase → Authorized domains)
DOMAIN=

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Signs login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Firebase project whose Google sign-ins are accepted
FIREBASE_PROJECT_ID=trustflow-1b008

# "true" adds a "Continue as guest" login (all guests share one account)
ALLOW_GUEST_LOGIN=false
